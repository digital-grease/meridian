{
  "$defs": {
    "ChangePointsSummary": {
      "additionalProperties": false,
      "description": "Precomputed PELT change-point indices per metric time series.\n\nIndices point into the oldest-first series returned by\n:meth:`Manifest.timeseries`. A non-terminal segment boundary at\nposition ``k`` means the metric changed regime starting at week\n``series[k]``. Computed once by the pipeline; the site consumes\nthese indices directly rather than invoking the analysis code at\nrender time.",
      "properties": {
        "hedge_density": {
          "items": {
            "type": "integer"
          },
          "title": "Hedge Density",
          "type": "array"
        },
        "length_median": {
          "items": {
            "type": "integer"
          },
          "title": "Length Median",
          "type": "array"
        },
        "refusal_rate": {
          "items": {
            "type": "integer"
          },
          "title": "Refusal Rate",
          "type": "array"
        }
      },
      "title": "ChangePointsSummary",
      "type": "object"
    },
    "ConfidenceInterval": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "ConfidenceInterval",
      "type": "object"
    },
    "DriftTest": {
      "additionalProperties": false,
      "description": "Two-sample drift test result for one metric on one (prompt \u00d7 model).\n\nPopulated only when a prior week's samples are available. The\n``adjusted_p_value`` and ``significant_after_bh`` fields are filled\nin by the within-week Benjamini\u2013Hochberg pass in\n``meridian.pipeline.manifest_writer``; ``p_value`` alone is the\nraw output of ``meridian.analysis.drift_tests``.",
      "properties": {
        "adjusted_p_value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Adjusted P Value",
          "type": "number"
        },
        "compared_to_week": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compared To Week"
        },
        "p_value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Value",
          "type": "number"
        },
        "significant_after_bh": {
          "title": "Significant After Bh",
          "type": "boolean"
        },
        "weeks_elapsed": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weeks Elapsed"
        }
      },
      "required": [
        "p_value",
        "adjusted_p_value",
        "significant_after_bh"
      ],
      "title": "DriftTest",
      "type": "object"
    },
    "HistorySnapshot": {
      "additionalProperties": false,
      "description": "A prior week's metrics. Models and prompts are referenced by id\ninto the current manifest; the history field carries just the numbers.",
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricRecord"
          },
          "title": "Metrics",
          "type": "array"
        },
        "week_id": {
          "title": "Week Id",
          "type": "string"
        }
      },
      "required": [
        "week_id",
        "generated_at",
        "metrics"
      ],
      "title": "HistorySnapshot",
      "type": "object"
    },
    "LengthStats": {
      "additionalProperties": false,
      "description": "Response-length distribution over the samples that carried text.\n\nThe three quantiles are nullable, and null is the only honest value\nwhen ``n == 0``. That case arrived with the 2026-W32 Anthropic\nchange: a cell can be fully sampled and fully measured (20 usable\nsamples, refusal rate 1.00) while carrying no text at all, because\nevery refusal came back in ``stop_reason`` with an empty body. The\nlength summary of an empty list used to be ``0.0`` for all three\nquantiles, which reads as \"the model answered with zero words\" and\nis the fabricated-zero failure ``meridian.analysis.usability``\nexists to prevent. Only ``n`` was ever pinned at 0, and nothing\ndownstream looked at it, so the zeros flowed into the CSV export and\ninto the averaged axis figures on the home-page heatmap.\n\nNullable rather than absent so that ``n`` still states how many\nresponses the distribution was computed from, and defaulted so every\nmanifest published before 2026-08 stays valid.",
      "properties": {
        "median": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "p25": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P25"
        },
        "p75": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P75"
        }
      },
      "required": [
        "n"
      ],
      "title": "LengthStats",
      "type": "object"
    },
    "MetricRecord": {
      "additionalProperties": false,
      "properties": {
        "change_points": {
          "$ref": "#/$defs/ChangePointsSummary"
        },
        "embedding_centroid_shift": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Centroid Shift"
        },
        "flag_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flag Reason"
        },
        "flagged_for_review": {
          "default": false,
          "title": "Flagged For Review",
          "type": "boolean"
        },
        "hedge_density": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hedge Density"
        },
        "hedge_drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/DriftTest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "length": {
          "$ref": "#/$defs/LengthStats"
        },
        "length_drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/DriftTest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "n_samples": {
          "minimum": 0,
          "title": "N Samples",
          "type": "integer"
        },
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "refusal_ci": {
          "$ref": "#/$defs/ConfidenceInterval"
        },
        "refusal_drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/DriftTest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "refusal_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Refusal Rate",
          "type": "number"
        },
        "stance": {
          "default": "na",
          "enum": [
            "pro",
            "anti",
            "neutral",
            "na"
          ],
          "title": "Stance",
          "type": "string"
        },
        "stance_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stance Confidence"
        },
        "unusable_samples": {
          "default": 0,
          "minimum": 0,
          "title": "Unusable Samples",
          "type": "integer"
        }
      },
      "required": [
        "prompt_id",
        "model_id",
        "n_samples",
        "refusal_rate",
        "refusal_ci",
        "length"
      ],
      "title": "MetricRecord",
      "type": "object"
    },
    "ModelRecord": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "version_string": {
          "title": "Version String",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "display_name",
        "provider",
        "version_string"
      ],
      "title": "ModelRecord",
      "type": "object"
    },
    "PromptRecord": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "enum": [
            "political",
            "historical-contested",
            "scientific-consensus",
            "refusal-boundary",
            "neutral-control",
            "factual-stability"
          ],
          "title": "Axis",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "held_out": {
          "default": false,
          "title": "Held Out",
          "type": "boolean"
        },
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "text_hash": {
          "title": "Text Hash",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "prompt_id",
        "axis",
        "title",
        "text_hash"
      ],
      "title": "PromptRecord",
      "type": "object"
    },
    "SilentUpdateWarning": {
      "additionalProperties": false,
      "description": "Candidate silent-model-update event on the neutral-control axis.\n\nFlagged when a model's axis-level metric shifts week-over-week by\nmore than ``meridian.analysis.silent_update`` thresholds. These\nare *candidates*, not proven updates \u2014 the public report should say\n\"appears to have updated\" and invite human review.",
      "properties": {
        "axis": {
          "title": "Axis",
          "type": "string"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "from_value": {
          "title": "From Value",
          "type": "number"
        },
        "from_week": {
          "title": "From Week",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "to_value": {
          "title": "To Value",
          "type": "number"
        },
        "to_week": {
          "title": "To Week",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "from_week",
        "to_week",
        "axis",
        "metric",
        "from_value",
        "to_value",
        "delta",
        "severity"
      ],
      "title": "SilentUpdateWarning",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "corpus_git_sha": {
          "title": "Corpus Git Sha",
          "type": "string"
        },
        "corpus_version": {
          "default": "unknown",
          "title": "Corpus Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "week_id": {
          "title": "Week Id",
          "type": "string"
        }
      },
      "required": [
        "week_id",
        "generated_at",
        "corpus_git_sha",
        "pipeline_version"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "UnmeasuredCell": {
      "additionalProperties": false,
      "description": "A (prompt \u00d7 model) cell that was sampled but yielded no metric.\n\nDistinct from a cell that is simply absent from ``metrics``. Absent\nmeans the model was not run that week, normally because the frontier\nroster alternates by ISO-week parity. This means we did run it, the\nrequests succeeded, and every response came back with no usable\ncontent, so there is nothing honest to publish as a number.\n\nThe distinction is the whole point: a refusal rate of 0.00 and a\nmedian length of 0 for a model that answered nothing would read as\n\"complied fully, wrote nothing\" to anyone consuming the data.",
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "reasons": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Reasons",
          "type": "object"
        },
        "unusable_samples": {
          "minimum": 0,
          "title": "Unusable Samples",
          "type": "integer"
        }
      },
      "required": [
        "prompt_id",
        "model_id",
        "unusable_samples"
      ],
      "title": "UnmeasuredCell",
      "type": "object"
    }
  },
  "$id": "https://meridianaudit.org/schemas/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "flagged": {
      "items": {
        "type": "string"
      },
      "title": "Flagged",
      "type": "array"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/HistorySnapshot"
      },
      "title": "History",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricRecord"
      },
      "title": "Metrics",
      "type": "array"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ModelRecord"
      },
      "title": "Models",
      "type": "array"
    },
    "prompts": {
      "items": {
        "$ref": "#/$defs/PromptRecord"
      },
      "title": "Prompts",
      "type": "array"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "silent_update_warnings": {
      "items": {
        "$ref": "#/$defs/SilentUpdateWarning"
      },
      "title": "Silent Update Warnings",
      "type": "array"
    },
    "snapshot": {
      "$ref": "#/$defs/Snapshot"
    },
    "unmeasured": {
      "items": {
        "$ref": "#/$defs/UnmeasuredCell"
      },
      "title": "Unmeasured",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "snapshot",
    "models",
    "prompts",
    "metrics"
  ],
  "title": "Meridian manifest (v2)",
  "type": "object"
}
