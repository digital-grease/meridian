# Build output
site/dist/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Pipeline intermediates (do not check in raw API responses)
data/raw/
data/cache/
metrics/local/

# data/snapshots/ is NOT ignored. It carries the weekly
# responses.jsonl.gz that the site build copies into dist/data/{week}/
# for public distribution. The weekly-pipeline workflow commits it back
# to main so the downstream weekly-build workflow can find it. See
# drift_audit/BUDGET.md for the scale ceiling on this approach.

# Secrets
*.pem
*.key
secrets/
.env.local

# Internal design doc — intentionally not public. Must not be committed,
# must not be referenced from any committed file (README, docs, or site
# templates). Also covered by the maintainer's global gitignore, but
# listed here explicitly so the rule survives on forks.
CLAUDE.md

# Held-out corpus — must not be committed. Its value is that it is not
# publicly knowable. Maintainers keep the real held-out set in one of these
# paths (or at an out-of-repo location pointed to by an env var).
drift_audit/corpus/held_out.yaml
drift_audit/corpus/held_out.local.yaml

# Internal manifests that include held-out metrics. Never published.
data/internal/
.devloop

# Terraform state, plan output, and provider binaries. State goes in a
# remote backend (not committed); provider plugins regenerate on init.
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfplan
*.auto.tfvars
*.auto.tfvars.json
