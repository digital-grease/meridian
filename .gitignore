secrets/
.env.local

# Internal design doc — intentionally not public. Must not be committed,
# must not be referenced from any committed file (README, docs, or site
# templates). Also covered by the maintainer's global gitignore, but
# listed here explicitly so the rule survives on forks.
CLAUDE.md

# Held-out corpus — must not be committed. Its value is that it is not
# publicly knowable. Maintainers keep the real held-out set in one of these
# paths (or at an out-of-repo location pointed to by an env var).
drift_audit/corpus/held_out.yaml
drift_audit/corpus/held_out.local.yaml

# Internal manifests that include held-out metrics. Never published.
data/internal/
.devloop
